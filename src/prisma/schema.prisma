generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Severity {
  CRITICO
  AVISO
  INFO
}

enum UserStatus {
  ATIVO
  PENDENTE
  INATIVO
}

// --- SISTEMA DE ACESSO ---
model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  githubUsername String?   @map("github_username") 
  avatarUrl      String?   @map("avatar_url")      
  password       String
  role           Role      @default(USER)
  resetToken     String?   @map("reset_token")
  refreshToken   String?   @map("refresh_token")
  email          String?   @unique   
  status         UserStatus @default(ATIVO) 

  // Relacionamentos
  teams           TeamUser[]
  rules           AnalysisRule[]
  prs             PullRequest[]
  reviewedResults AnalysisResult[] @relation("ReviewedBy")

  @@map("users")
}

// --- TIMES (SQUADS) ---
model Team {
  id          String    @id @default(uuid())
  name        String
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relacionamentos
  members     TeamUser[]
  repositories Repository[]

  @@map("teams")
}

model TeamUser {
  teamId    String   @map("team_id")
  userId    Int      @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Chaves Estrangeiras
  team      Team @relation(fields: [teamId], references: [id])
  user      User @relation(fields: [userId], references: [id])

  @@id([teamId, userId]) // Chave composta — evita duplicata no mesmo time
  @@map("team_users")
}

// --- CORE DO BOT E GESTÃO ---
model Repository {
  id        String   @id @default(uuid())
  name      String
  githubId  Int      @unique @map("github_id")
  githubUrl String?  @map("github_url") // URL do repositório no GitHub
  teamId    String   @map("team_id")
  isActive  Boolean  @default(true) @map("is_active") // Soft delete
  createdAt DateTime @default(now()) @map("created_at")

  // Relacionamentos
  team      Team           @relation(fields: [teamId], references: [id])
  rules     AnalysisRule[]
  prs       PullRequest[]

  @@map("repositories")
}

model AnalysisRule {
  id           String     @id @default(uuid())
  repositoryId String     @map("repository_id")
  ruleType     String     @map("rule_type") // Ex: "segurança", "clean_code"
  content      String     // MD ou JSON para a IA
  createdById  Int        @map("created_by")
  severity     Severity   @default(AVISO)         // Crítico, Aviso ou Info
  isActive     Boolean    @default(true)          // Ativo ou Inativo

  // Relacionamentos
  repository   Repository @relation(fields: [repositoryId], references: [id])
  createdBy    User       @relation(fields: [createdById], references: [id])

  @@map("analysis_rules")
}

// --- FLUXO DE REVISÃO (CODE REVIEW) ---
model PullRequest {
  id           String    @id @default(uuid())
  repositoryId String    @map("repository_id")
  prNumber     Int       @map("pr_number")
  authorId     Int       @map("author_id")
  title        String?   // Título do PR
  githubUrl    String?   @map("github_url") // Link direto para o PR no GitHub
  status       String    // "aberto" | "fechado" | "mergeado"
  openedAt     DateTime  @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at") // Nullable — só preenchido ao fechar

  // Relacionamentos
  repository   Repository       @relation(fields: [repositoryId], references: [id])
  author       User             @relation(fields: [authorId], references: [id])
  results      AnalysisResult[]

  @@map("pull_requests")
}

model AnalysisResult {
  id          String      @id @default(uuid())
  prId        String      @map("pr_id")
  healthScore Float       @map("health_score") // Nota de 0 a 100
  iaFeedback  String      @map("ia_feedback")  // Comentário final postado pelo bot
  status      String      @default("pendente") // "pendente" | "aprovado" | "rejeitado"
  reviewedById Int?       @map("reviewed_by")  // Admin/Dev que revisou o feedback da IA
  reviewedAt  DateTime?   @map("reviewed_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relacionamentos
  pr          PullRequest @relation(fields: [prId], references: [id])
  reviewedBy  User?       @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@map("analysis_results")
}

// --- CONFIGURAÇÕES DO SISTEMA ---
model Config {
  id        String   @id @default(uuid())
  key       String   @unique // Ex: "Rigidez da Análise"
  value     String   // Valor da configuração (pode ser JSON, número, texto)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configs")
}
