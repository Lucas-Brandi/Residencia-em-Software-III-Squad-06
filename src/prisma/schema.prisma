generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Severity {
  CRITICO
  AVISO
  INFO
}

enum UserStatus {
  ATIVO
  PENDENTE
  INATIVO
}

// --- SISTEMA DE ACESSO ---
model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  githubUsername String?    @map("github_username")
  avatarUrl      String?    @map("avatar_url")
  password       String
  role           Role       @default(USER)
  resetToken     String?    @map("reset_token")
  refreshToken   String?    @map("refresh_token")
  email          String?    @unique
  status         UserStatus @default(ATIVO)

  // Relacionamentos
  teams           TeamUser[]
  rules           AnalysisRule[]
  prs             PullRequest[]
  reviewedResults AnalysisResult[] @relation("ReviewedBy")

  @@map("users")
}

// --- TIMES (SQUADS) ---
model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  // Relacionamentos
  members      TeamUser[]
  repositories Repository[]

  @@map("teams")
}

model TeamUser {
  teamId   String   @map("team_id")
  userId   Int      @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_users")
}

// --- CORE DO BOT E GESTÃO ---
model Repository {
  id               String   @id @default(uuid())
  name             String
  githubId         Int      @unique @map("github_id")
  githubUrl        String?  @map("github_url")
  teamId           String?  @map("team_id")
  isActive         Boolean  @default(true) @map("is_active")
  isAutoRegistered Boolean  @default(false) @map("is_auto_registered")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relacionamentos
  team  Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rules RuleRepository[]
  prs   PullRequest[]

  @@map("repositories")
}

model AnalysisRule {
  id          String   @id @default(uuid())
  title       String
  description String?
  ruleType    String   @map("rule_type")
  content     String
  createdById Int      @map("created_by")
  severity    Severity @default(AVISO)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  repositories RuleRepository[]
  findings     Finding[]
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@map("analysis_rules")
}

// Tabela intermediária Many-to-Many entre AnalysisRule e Repository
model RuleRepository {
  id           String   @id @default(uuid())
  ruleId       String   @map("rule_id")
  repositoryId String   @map("repository_id")
  createdAt    DateTime @default(now()) @map("created_at")

  rule       AnalysisRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  repository Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([ruleId, repositoryId])
  @@map("rule_repositories")
}

// --- FLUXO DE REVISÃO (CODE REVIEW) ---
model PullRequest {
  id           String    @id @default(uuid())
  repositoryId String    @map("repository_id")
  prNumber     Int       @map("pr_number")
  authorId     Int?      @map("author_id") // nullable: autor pode não ter conta no sistema
  title        String?
  githubUrl    String?   @map("github_url")
  status       String
  openedAt     DateTime  @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at")

  repository Repository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author     User?            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  results    AnalysisResult[]

  @@unique([repositoryId, prNumber])
  @@map("pull_requests")
}

model AnalysisResult {
  id           String    @id @default(uuid())
  prId         String    @map("pr_id")
  healthScore  Float     @map("health_score")
  iaFeedback   String    @map("ia_feedback")
  status       String    @default("pendente")
  reviewedById Int?      @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  pr         PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  reviewedBy User?       @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  findings   Finding[]

  @@map("analysis_results")
}

// --- FINDINGS DA IA ---
model Finding {
  id               String   @id @default(uuid())
  analysisResultId String   @map("analysis_result_id")
  ruleId           String?  @map("rule_id")
  severity         Severity
  description      String
  filePath         String?  @map("file_path")
  lineNumber       Int?     @map("line_number")
  createdAt        DateTime @default(now()) @map("created_at")

  analysisResult AnalysisResult @relation(fields: [analysisResultId], references: [id], onDelete: Cascade)
  rule           AnalysisRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@map("findings")
}

// --- CONFIGURAÇÕES DO SISTEMA ---
model Config {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configs")
}
